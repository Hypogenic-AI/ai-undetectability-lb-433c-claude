% Simplified NeurIPS style (no environ dependency)
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{neurips_simple}[2025/01/18 Simplified NeurIPS style]

% Options
\newif\if@final\@finalfalse
\DeclareOption{final}{\@finaltrue}
\DeclareOption{preprint}{}
\ProcessOptions\relax

% Page layout
\RequirePackage[verbose=true,letterpaper]{geometry}
\AtBeginDocument{
  \newgeometry{
    textheight=9in,
    textwidth=5.5in,
    top=1in,
    headheight=12pt,
    headsep=25pt,
    footskip=30pt
  }
}

% Fonts
\RequirePackage{times}

% natbib for citations
\RequirePackage{natbib}

% Title formatting
\def\@maketitle{%
  \vbox to \titlebox{\vfil
    \vskip 0.2in
    {\centering
     \large\bfseries\@title\par}%
    \vskip 0.2in
    {\centering\normalsize
     \lineskip .5em
     \begin{tabular}[t]{c}%
       \@author
     \end{tabular}\par}%
    \vfil}}

\newlength{\titlebox}
\setlength{\titlebox}{2.25in}

% Section formatting
\renewcommand\section{\@startsection {section}{1}{\z@}%
  {-2.5ex \@plus -1ex \@minus -.2ex}%
  {1.3ex \@plus.2ex}%
  {\normalfont\large\bfseries}}
\renewcommand\subsection{\@startsection{subsection}{2}{\z@}%
  {-2.0ex\@plus -1ex \@minus -.2ex}%
  {0.8ex \@plus .2ex}%
  {\normalfont\normalsize\bfseries}}
\renewcommand\subsubsection{\@startsection{subsubsection}{3}{\z@}%
  {-1.25ex\@plus -1ex \@minus -.2ex}%
  {0.5ex \@plus .2ex}%
  {\normalfont\normalsize\bfseries}}
\renewcommand\paragraph{\@startsection{paragraph}{4}{\z@}%
  {0.5ex \@plus1ex \@minus.2ex}%
  {-1em}%
  {\normalfont\normalsize\bfseries}}

% Abstract
\renewenvironment{abstract}{%
  \centerline{\large\bfseries Abstract}%
  \vspace{0.5ex}%
  \begin{quote}%
}{%
  \par\end{quote}\vskip 1ex%
}

% Spacing
\setlength{\parskip}{0pt}
\setlength{\parindent}{1em}

% Footer
\if@final
  \def\ps@firstpage{%
    \let\@oddhead\@empty
    \let\@evenhead\@empty
    \def\@oddfoot{\hfil\small 38th Conference on Neural Information Processing Systems (NeurIPS 2025)}%
    \let\@evenfoot\@oddfoot
  }
\else
  \def\ps@firstpage{%
    \let\@oddhead\@empty
    \let\@evenhead\@empty
    \let\@oddfoot\@empty
    \let\@evenfoot\@oddfoot
  }
\fi

\pagestyle{empty}
\thispagestyle{firstpage}

\endinput
